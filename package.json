{
  "name": "blackjack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "BLACKJACK 21 — a premium single-player blackjack table.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:arena": "tsc -p tsconfig.arena.json",
    "lint": "eslint .",
    "sim": "vite-node scripts/simulate.ts",
    "sim:fairness": "vite-node scripts/simulate.ts --fairness",
    "sim:ai": "vite-node scripts/simulate.ts --ai",
    "sim:learning": "vite-node scripts/holdem-learning.ts",
    "sim:adaptive": "vite-node scripts/holdem-adaptive.ts",
    "sim:adaptive:sweep": "vite-node scripts/holdem-adaptive-sweep.ts",
    "sim:learner:response": "vite-node scripts/learner-response.ts",
    "sim:learner:tune": "vite-node scripts/learner-tune.ts",
    "sim:learner:eval": "vite-node scripts/holdem-learner-eval.ts",
    "sim:learner:cost": "vite-node scripts/learner-cost.ts",
    "sim:house": "vite-node scripts/house-edge.ts",
    "lab": "vite-node scripts/holdem-lab.ts",
    "party:server": "vite-node scripts/party-server.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vite-node": "^3.2.4",
    "vitest": "^5.0.3"
  }
}
